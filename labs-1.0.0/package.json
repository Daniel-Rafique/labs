    "axios": "1.9.0",
    "bs58": "5.0.0",
    "chalk": "4.1.2",
    "commander": "12.0.0",
    "decimal.js": "10.4.3",
    "dotenv": "16.4.5",
    "figlet": "1.7.0",
    "https-proxy-agent": "7.0.2",
    "inquirer": "8.2.5",
    "module-alias": "2.2.3",
    "node-machine-id": "1.1.12",
